# Copy this file to .env and replace the required values.
# Non-empty STICK_* values override values from earlier configuration providers.
# The API is available below <public-url>/api/v1.

# Required application settings. A filesystem path selects SQLite;
# postgres://, postgresql://, mongodb://, or mongodb+srv:// selects the
# corresponding database backend. MongoDB must use a replica set or mongos.
STICK_DATABASE=/data/stick.db
# Optional public URL used for notification links and the application mount path.
# Defaults to http://localhost. HTTPS is required for non-local URLs.
STICK_SERVER_PUBLIC_URL=http://localhost:8080
# Address to bind (default: :8080).
STICK_SERVER_LISTEN_ADDR=:8080

# External JWT validation settings.
STICK_AUTH_IDP_ENDPOINT=https://accounts.google.com
STICK_AUTH_AUDIENCE=your-api-audience
STICK_AUTH_SCOPE=your-required-scope

# Optional comma-separated administrator list.
# STICK_AUTH_ADMIN_EMAILS=alice@example.com,bob@example.com

# Optional timezone.
# STICK_TIMEZONE=Europe/London

# Optional notification backends. Configure one or more of SMTP, webhook, or Teams.
# Webhook URLs must use HTTPS except for loopback addresses used locally.
# STICK_NOTIFICATIONS_WEBHOOK_URL=https://hooks.example.com/your-hook
# STICK_NOTIFICATIONS_TEAMS_URL=https://your-tenant.webhook.office.com/webhookb2/your-webhook
# SMTP TLS mode is starttls by default; use implicit for TLS from the start.
# STICK_NOTIFICATIONS_SMTP_HOST=smtp.example.com
# STICK_NOTIFICATIONS_SMTP_PORT=587
# STICK_NOTIFICATIONS_SMTP_TLS_MODE=starttls
# STICK_NOTIFICATIONS_SMTP_USERNAME=noreply@example.com
# STICK_NOTIFICATIONS_SMTP_PASSWORD=your-smtp-password
# STICK_NOTIFICATIONS_SMTP_FROM=noreply@example.com
# STICK_NOTIFICATIONS_SMTP_SUBJECT={{.StickName}} is available
# STICK_NOTIFICATIONS_SMTP_BODY=The stick you were waiting for just dropped.

# Optional Azure App Configuration source. This is bootstrap configuration and
# is not read from the application YAML file. Use a managed identity or Azure
# Workload Identity in deployments; do not put a client secret here.
# STICK_CONFIG_PROVIDERS=azure-app-config,environment
# STICK_AZURE_APPCONFIG_ENDPOINT=https://stick-prod.azconfig.io
# STICK_AZURE_APPCONFIG_LABEL=production
# STICK_AZURE_APPCONFIG_KEY_PREFIX=stick/
# STICK_AZURE_APPCONFIG_KEY_FILTER=stick/*
# STICK_AZURE_APPCONFIG_SEPARATOR=/
